{
  "name": "@tuwaio/quasar",
  "version": "0.4.2",
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-monaco.mjs && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node scripts/copy-monaco.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:create": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:db-schema": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "payload": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation tsx src/payload/seed-runner.community.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/loader": "1.7.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@pdfme/generator": "^6.2.5",
    "@pdfme/schemas": "^6.2.5",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tuwaio/docs-ui": "^0.4.1",
    "@tuwaio/sdk": "^0.6.1",
    "@tuwaio/shared": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^6.3.15",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "14.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.1",
    "otplib": "^13.5.0",
    "payload": "3.90.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "viem": "^2.57.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-paginate": "^7.1.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^5.0.5"
  }
}
