# ──────────────────────────────────────────────
# DOMAIN
# ──────────────────────────────────────────────
DOMAIN=localhost
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
# Only needed to run scripts/setup-cloudflare-tunnel.sh (optional, non-
# interactive tunnel + DNS automation via the Cloudflare API). Leave empty if
# you configure the tunnel manually in the Zero Trust dashboard instead.
#
# CLOUDFLARE_API_TOKEN must be USER-owned: My Profile -> API Tokens -> Create
# Token -> Custom token. An ACCOUNT-owned token (Manage Account -> API Tokens)
# does NOT work — it passes the tunnel calls and then fails every DNS call with
# [10000] Authentication error, even with Zone:DNS:Edit granted.
# Two permissions, both at Edit: Account:Cloudflare Tunnel + Zone:DNS.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Production application image references are injected by CI/CD and must be
# full signed ghcr.io/...@sha256 values. Do not persist mutable application
# tags in this file. Staging retains its explicit QUASAR_IMAGE_TAG fallback.
# ──────────────────────────────────────────────
# TRAEFIK DASHBOARD
# ──────────────────────────────────────────────
TRAEFIK_USER=admin
TRAEFIK_PASSWORD=change-me
# ──────────────────────────────────────────────
# POSTGRESQL
# ──────────────────────────────────────────────
PG_USER=quasar
PG_PASSWORD=change-me
PG_DB=quasar
# Host and port live inside the URLs below; pgbouncer gets its upstream from
# docker-compose, not from here.
DATABASE_URL="postgresql://quasar:change-me@pgbouncer:5432/quasar"
DATABASE_URL_READ="postgresql://quasar:change-me@pgbouncer:5432/quasar"
# PostgreSQL HA (repmgr)
REPMGR_PASSWORD=change-me
# WAL-G continuous encrypted WAL archiving and base backups
# The prefix must be separate from logical pg-backup objects.
# If omitted in a deployment, Compose derives it as
# s3://${S3_BUCKET_POSTGRES}/wal-g. Keep both layers in the same private bucket
# only when the bucket policy and retention policy are intentionally shared.
WALG_S3_PREFIX=s3://quasar-pg-backup/wal-g
WALG_LIBSODIUM_KEY=replace-with-a-random-32-byte-base64-key
WALG_LIBSODIUM_KEY_TRANSFORM=base64
WALG_PREVENT_WAL_OVERWRITE=true
WALG_UPLOAD_CONCURRENCY=2
WALG_DOWNLOAD_CONCURRENCY=2
WALG_BACKUP_INTERVAL_SECONDS=86400
WALG_BACKUP_ON_START=yes
WALG_RETAIN_FULL_BACKUPS=7
# Database Connection Pool
DATABASE_POOL_MAX=15
DATABASE_POOL_MAX_READ=20
DATABASE_POOL_TIMEOUT=5000
DATABASE_POOL_IDLE_TIMEOUT=10000
# ──────────────────────────────────────────────
# PGADMIN
# ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
# ──────────────────────────────────────────────
# BACKUPS (S3 / Cloudflare R2)
# ──────────────────────────────────────────────
PG_BACKUP_SCHEDULE=@daily
# Daily retention is the only granularity postgres-backup-s3 supports.
PG_BACKUP_KEEP_DAYS=7
PG_BACKUP_PASSPHRASE=replace-with-a-long-random-backup-passphrase

S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=auto
S3_S3V4=yes
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_MEDIA=quasar-media
S3_BUCKET_POSTGRES=quasar-pg-backup
# ──────────────────────────────────────────────
# REDIS — API Cluster (BullMQ, IronDome, Tracking, Workers)
# ──────────────────────────────────────────────
REDIS_API_PASSWORD=change-me
REDIS_API_CLUSTER_ENABLED=no
# 'cluster' switches the client to cluster mode; any other value is standalone.
REDIS_API_MODE=single
REDIS_API_URL="redis://:change-me@redis-api-node-1:6379"
# ──────────────────────────────────────────────
# REDIS — UI Cluster (Rate Limiting, 2FA Locks, Sessions)
# ──────────────────────────────────────────────
REDIS_UI_PASSWORD=change-me
REDIS_UI_MODE=single
REDIS_UI_URL="redis://:change-me@redis-ui-node-1:6379"
# ──────────────────────────────────────────────
# QUASAR APP (Next.js / Payload)
# ──────────────────────────────────────────────
PAYLOAD_SECRET=your-payload-secret
# CRITICAL: In staging/production this MUST be your actual public domain (e.g. https://quasar.example.com).
# Used for email verification links and Payload's internal serverURL. If set to localhost in production,
# email verification links will be broken and users will see "Verification token is invalid."
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
RP_NAME=Quasar
ALCHEMY_API_KEY=your-alchemy-key
ALCHEMY_API_KEY_FALLBACK=your-alchemy-key
# CRITICAL: Must match NEXT_PUBLIC_SERVER_URL exactly in production (same domain).
# Used by the proxy middleware for origin/CORS validation and Payload CSRF protection.
NEXT_PUBLIC_APP_URL=http://localhost:3000
GELATO_API_KEY=test_gelato_key
PIMLICO_API_KEY=your-pimlico-api-key
# ──────────────────────────────────────────────
# GRAFANA
# ──────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
# Ops alerting (Grafana Alerting + Prometheus Alertmanager) — no email/SMTP.
# Set at least one of the two channels below; both may be set to notify both.
# Discord: create a webhook in the target channel's settings and paste its URL.
DISCORD_WEBHOOK_URL=
# Telegram: create a bot via @BotFather for the token, and get the numeric
# chat/channel ID (e.g. via @userinfobot or the getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ──────────────────────────────────────────────
# QUASAR SDK
# ──────────────────────────────────────────────
# Public URL used by browser-side Engine calls and UI testing.
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001
# Docker Compose supplies INTERNAL_ENGINE_URL for container deployments. When
# running the dashboard natively, it falls back to NEXT_PUBLIC_ENGINE_URL.
# ──────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────
ENCRYPTION_KEY=your-32-chars-encryption-key
# Bootstrap-only secret for internal service authentication.
# Generate at least 32 random characters. After startup, the active and
# previous rotation keys are managed in API Redis; do not add current/previous
# keys to .env and do not treat this value as a permanent runtime credential.
INTERNAL_SECRET=replace-with-at-least-32-random-characters
MAX_LOGIN_ATTEMPTS=25
# ONLY LOCAL. Lets webhooks and RPC endpoints (App RPC overrides, QuickNode
# URLs, bundler URLs) reach private and loopback hosts over plain http, e.g. a
# local anvil at http://host.docker.internal:8545. Keep false in every deployment.
ALLOW_INTERNAL_WEBHOOKS=false

# ──────────────────────────────────────────────
# AML / GOPLUS (https://gopluslabs.io) [OPTIONAL — PAYMENTS APPS ONLY]
# Only required if deploying with upcoming Payments / On-Chain Checkout apps.
# For core Quasar transaction tracking & indexing, these can remain unset or blank.
# ──────────────────────────────────────────────
# GOPLUS_APP_KEY=your-goplus-key
# GOPLUS_APP_SECRET=your-goplus-secret
# Fallback credentials used for Payments apps that don't provide their own GoPlus key (+5 quota penalty)
# FALLBACK_GOPLUS_APP_KEY=your-fallback-goplus-key
# FALLBACK_GOPLUS_APP_SECRET=your-fallback-goplus-secret
# ──────────────────────────────────────────────
# SENTRY
# ──────────────────────────────────────────────
SENTRY_AUTH_TOKEN=your-sentry-token
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_NEST_DSN=your-sentry-nest-dsn
# Org and project slugs from your own Sentry account, not ours — source-map
# upload targets whatever is set here. Placeholders like every other credential
# in this file: the real values live in .env, which is gitignored.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT_DASHBOARD=your-sentry-dashboard-project
SENTRY_PROJECT_ENGINE=your-sentry-engine-project
# ──────────────────────────────────────────────
# Monitoring
# ──────────────────────────────────────────────
# ──────────────────────────────────────────────
# Super User For Payload CMS & Database Seed
# ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=email
SEED_ADMIN_PASSWORD=strong_password
# Optional; leave empty to avoid creating a system webhook during seed.
# Default recipient wallet address for accepted billing payments created during seed
# ──────────────────────────────────────────────
# CONCURRENCY & SCALE
# ──────────────────────────────────────────────
# Payload Database Connection Pool Max (dashboard isolation)
PAYLOAD_DATABASE_POOL_MAX=4

# 2FA Attempt Lockout Duration (in seconds)
LOCKOUT_2FA_DURATION=300

# Worker and Webhook Concurrency Limits
TRACKING_FAST_CONCURRENCY=25
TRACKING_LAZY_CONCURRENCY=15
WEBHOOK_CONCURRENCY=15
WEBHOOK_LIMITER_MAX=200
WEBHOOK_LIMITER_DURATION=1000
