{
  "name": "@tuwaio/quasar-nest",
  "version": "0.0.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "High-performance NestJS microservice for Quasar hot paths",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start:dev": "tsc --watch",
    "start:debug": "node --inspect dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:pull": "dotenv -e ../../.env -- drizzle-kit introspect",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/nestjs": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "@tuwaio/orbit-core": "^0.3.0",
    "@tuwaio/orbit-evm": "^0.3.0",
    "@tuwaio/orbit-solana": "^0.3.0",
    "@tuwaio/pulsar-core": "^0.7.0",
    "@tuwaio/pulsar-evm": "^0.6.0",
    "@tuwaio/pulsar-solana": "^0.7.0",
    "@tuwaio/quasar-sdk": "^0.1.8",
    "@tuwaio/shared": "workspace:*",
    "@wagmi/core": "^3.6.5",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "@solana/kit": "^8.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/redlock": "^4.0.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
  }
}
