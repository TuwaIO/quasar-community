{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@tuwaio/shared/encryption": ["../../packages/shared/dist/encryption.d.ts"],
      "@tuwaio/shared/cuid": ["../../packages/shared/dist/cuid.d.ts"],
      "@tuwaio/shared/constants": ["../../packages/shared/dist/constants.d.ts"],
      "@tuwaio/shared/billing": ["../../packages/shared/dist/billing.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "../../node_modules"]
}
